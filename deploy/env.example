# Copy to server/.env on the server and fill in real values.
# Never commit the real .env file (it's already in .gitignore).

PORT=3000
ADMIN_PASSWORD=change-this-to-a-strong-password

# Telegram-уведомления о новых заявках/обращениях (необязательно, но сильно
# рекомендуется — без этого заявки видны только в /admin.html).
# Как получить: docs/launch-checklist.md, раздел «Уведомления».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
